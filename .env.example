# Anything set here is locked in the web UI. Leave a setting out (or commented) to manage it from
# the Settings page instead; those values are saved to ./data/settings.json.

# --- Web UI (environment only) ---
WEB_USER=admin
WEB_PASSWORD=
WEB_PORT=8091

# --- qBittorrent ---
# URL as reachable from this container (service name on the shared Docker network).
QBIT_URL=http://qbittorrent:8080
# QBIT_USERNAME=
# QBIT_PASSWORD=

# --- Policy (or set these in the web UI) ---
# Hostname of the only tracker allowed to seed. Subdomains match too.
# APPROVED_TRACKER=t.myanonamouse.net
# Approved-tracker torrents to keep seeding in total.
# TARGET_SEEDING=190
# MAM session (Preferences -> Security on MAM). When set, torrents MAM lists as unsatisfied or
# hit & run always seed, even beyond the target.
# MAM_ID=
# Torrents that completed within this many hours always seed, even beyond the target. 0 = off.
# MAX_AGE_HOURS=72
# How often to run.
# INTERVAL_MINUTES=15
# true = only show what would change. Starts on; turn it off once the status page looks right.
# DRY_RUN=true
